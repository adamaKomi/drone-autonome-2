#!/usr/bin/env python3
"""
Script CLI: drone_emergency - Gestion des urgences drone
Usage: drone_emergency <command> [options]
"""

import rclpy
from rclpy.node import Node
import sys
import argparse
import json
import time
from datetime import datetime


def main():
    parser = argparse.ArgumentParser(description='Gestion urgences drone')
    subparsers = parser.add_subparsers(dest='command', help='Commandes d\'urgence')
    
    # Sous-commande: land
    land_parser = subparsers.add_parser('land', help='Atterrissage d\'urgence')
    land_parser.add_argument('--immediate', action='store_true', help='Atterrissage immédiat')
    land_parser.add_argument('--location', help='Coordonnées: lat,lon')
    
    # Sous-commande: rtl
    rtl_parser = subparsers.add_parser('rtl', help='Return To Launch')
    rtl_parser.add_argument('--altitude', type=float, help='Altitude de retour')
    
    # Sous-commande: hold
    hold_parser = subparsers.add_parser('hold', help='Maintenir position actuelle')
    hold_parser.add_argument('--duration', type=int, help='Durée en secondes')
    
    # Sous-commande: kill
    kill_parser = subparsers.add_parser('kill', help='Arrêt moteurs (DANGER!)')
    kill_parser.add_argument('--confirm', action='store_true', help='Confirmation obligatoire')
    
    # Sous-commande: geofence
    geofence_parser = subparsers.add_parser('geofence', help='Actions géofence')
    geofence_parser.add_argument('action', choices=['breach', 'return', 'status'])
    
    # Sous-commande: status
    status_parser = subparsers.add_parser('status', help='Statut urgence')
    
    # Sous-commande: override
    override_parser = subparsers.add_parser('override', help='Override sécurité')
    override_parser.add_argument('--code', help='Code d\'override')
    override_parser.add_argument('--duration', type=int, default=30, help='Durée override (s)')
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return 1
    
    rclpy.init()
    
    try:
        node = Node('drone_emergency_cli')
        
        # Vérification préalable du statut système
        if not verify_system_ready(node):
            print("❌ Système non prêt pour commandes d'urgence")
            return 1
        
        # Exécution selon la commande
        if args.command == 'land':
            return emergency_land(node, args)
        elif args.command == 'rtl':
            return return_to_launch(node, args)
        elif args.command == 'hold':
            return hold_position(node, args)
        elif args.command == 'kill':
            return motor_kill(node, args)
        elif args.command == 'geofence':
            return geofence_action(node, args)
        elif args.command == 'status':
            return emergency_status(node, args)
        elif args.command == 'override':
            return safety_override(node, args)
            
    except KeyboardInterrupt:
        print("\n🛑 Commande d'urgence interrompue")
        return 0
    except Exception as e:
        print(f"❌ Erreur critique: {e}")
        return 1
    finally:
        rclpy.shutdown()


def verify_system_ready(node):
    """Vérifie que le système est prêt pour les commandes d'urgence"""
    # TODO: Vérifier connexion MAVROS, état drone, etc.
    print("🔍 Vérification système...")
    time.sleep(0.5)
    return True


def emergency_land(node, args):
    """Atterrissage d'urgence"""
    print("🚨 === ATTERRISSAGE D'URGENCE ===")
    
    if args.immediate:
        print("⚠️ ATTERRISSAGE IMMÉDIAT ACTIVÉ")
        print("⚠️ Le drone va atterrir à la position actuelle")
    else:
        print("🛬 Atterrissage d'urgence contrôlé")
    
    # Parsing location si fournie
    target_location = None
    if args.location:
        try:
            coords = [float(x) for x in args.location.split(',')]
            if len(coords) != 2:
                raise ValueError("Format invalide")
            target_location = {'lat': coords[0], 'lon': coords[1]}
            print(f"📍 Location cible: {target_location['lat']}, {target_location['lon']}")
        except ValueError:
            print("❌ Format location invalide. Utilisez: lat,lon")
            return 1
    
    # Confirmation utilisateur
    if not args.immediate:
        response = input("Confirmer l'atterrissage d'urgence? (y/N): ")
        if response.lower() != 'y':
            print("❌ Atterrissage annulé")
            return 1
    
    # Séquence d'atterrissage
    print("🚁 Début séquence d'atterrissage...")
    
    steps = [
        "Arrêt mission en cours",
        "Stabilisation attitude",
        "Recherche zone d'atterrissage",
        "Descente contrôlée",
        "Atterrissage final"
    ]
    
    for i, step in enumerate(steps, 1):
        print(f"   {i}/5: {step}...")
        time.sleep(1)
    
    print("✅ Atterrissage d'urgence terminé")
    print("🛡️ Drone sécurisé")
    
    # Log de l'événement
    log_emergency_event({
        'type': 'EMERGENCY_LAND',
        'immediate': args.immediate,
        'location': target_location,
        'timestamp': datetime.now().isoformat()
    })
    
    return 0


def return_to_launch(node, args):
    """Return To Launch"""
    print("🏠 === RETURN TO LAUNCH ===")
    
    # Récupération point de décollage
    launch_point = get_launch_point()
    if not launch_point:
        print("❌ Point de décollage non disponible")
        return 1
    
    print(f"📍 Point de décollage: {launch_point['lat']}, {launch_point['lon']}")
    
    if args.altitude:
        print(f"🛫 Altitude de retour: {args.altitude}m")
    
    # Confirmation
    response = input("Confirmer Return To Launch? (y/N): ")
    if response.lower() != 'y':
        print("❌ RTL annulé")
        return 1
    
    # Séquence RTL
    print("🚁 Début séquence RTL...")
    
    steps = [
        "Arrêt mission en cours",
        "Montée à altitude sécurisée",
        "Navigation vers point de décollage",
        "Approche finale",
        "Atterrissage au point de décollage"
    ]
    
    for i, step in enumerate(steps, 1):
        print(f"   {i}/5: {step}...")
        time.sleep(1.5)
    
    print("✅ Return To Launch terminé")
    
    # Log de l'événement
    log_emergency_event({
        'type': 'RTL',
        'altitude': args.altitude,
        'launch_point': launch_point,
        'timestamp': datetime.now().isoformat()
    })
    
    return 0


def hold_position(node, args):
    """Maintenir position actuelle"""
    print("⏸️ === MAINTIEN POSITION ===")
    
    # Récupération position actuelle
    current_pos = get_current_position()
    print(f"📍 Position: {current_pos['lat']:.6f}, {current_pos['lon']:.6f}, {current_pos['alt']:.1f}m")
    
    duration = args.duration if args.duration else None
    
    if duration:
        print(f"⏱️ Durée: {duration} secondes")
    else:
        print("⏱️ Durée: Indéfinie (jusqu'à nouvelle commande)")
    
    # Activation hold
    print("🚁 Activation maintien position...")
    
    if duration:
        print(f"⏳ Maintien pour {duration}s...")
        time.sleep(min(duration, 3))  # Simulation limitée
        print("✅ Maintien position terminé")
    else:
        print("✅ Mode maintien position activé")
    
    # Log de l'événement
    log_emergency_event({
        'type': 'HOLD_POSITION',
        'position': current_pos,
        'duration': duration,
        'timestamp': datetime.now().isoformat()
    })
    
    return 0


def motor_kill(node, args):
    """Arrêt moteurs (EXTRÊME DANGER)"""
    print("💀 === ARRÊT MOTEURS ===")
    print("⚠️ DANGER: Cette commande arrête immédiatement tous les moteurs")
    print("⚠️ Le drone va chuter ! Utiliser uniquement en cas d'extrême urgence")
    
    if not args.confirm:
        print("\n🔴 CONFIRMATION OBLIGATOIRE")
        print("Tapez 'KILL MOTORS' pour confirmer:")
        response = input("> ")
        
        if response != "KILL MOTORS":
            print("❌ Arrêt moteurs annulé")
            return 1
    
    print("\n💀 ARRÊT MOTEURS EN COURS...")
    print("3...")
    time.sleep(1)
    print("2...")
    time.sleep(1)
    print("1...")
    time.sleep(1)
    print("💀 MOTEURS ARRÊTÉS")
    
    # Log critique
    log_emergency_event({
        'type': 'MOTOR_KILL',
        'confirmed': True,
        'timestamp': datetime.now().isoformat(),
        'severity': 'CRITICAL'
    })
    
    return 0


def geofence_action(node, args):
    """Actions géofence"""
    print(f"🏁 === GÉOFENCE {args.action.upper()} ===")
    
    if args.action == 'breach':
        print("⚠️ Violation géofence détectée")
        
        # Actions automatiques
        actions = [
            "Arrêt progression",
            "Évaluation position",
            "Calcul retour zone sûre",
            "Navigation retour"
        ]
        
        for i, action in enumerate(actions, 1):
            print(f"   {i}/4: {action}...")
            time.sleep(0.8)
        
        print("✅ Retour en zone autorisée")
    
    elif args.action == 'return':
        print("🔄 Forcer retour en géofence")
        
        safe_zone = get_safe_zone_center()
        print(f"📍 Zone sûre: {safe_zone['lat']}, {safe_zone['lon']}")
        
        print("🚁 Navigation vers zone sûre...")
        time.sleep(2)
        print("✅ Retour en géofence effectué")
    
    elif args.action == 'status':
        geofence_status = get_geofence_status()
        print(f"Status: {'🟢 DANS ZONE' if geofence_status['inside'] else '🔴 HORS ZONE'}")
        print(f"Distance limite: {geofence_status['distance_to_fence']:.1f}m")
        print(f"Zone active: {geofence_status['active_fence']}")
    
    return 0


def emergency_status(node, args):
    """Statut des systèmes d'urgence"""
    print("🚨 === STATUT URGENCE ===")
    
    # Récupération statuts
    status = get_emergency_status()
    
    print(f"🔋 Batterie: {status['battery']:.1f}% ({'🟢' if status['battery'] > 20 else '🔴'})")
    print(f"📡 Lien télémétrie: {'🟢 OK' if status['telemetry'] else '🔴 PERDU'}")
    print(f"🎮 Lien radiocommande: {'🟢 OK' if status['rc_link'] else '🔴 PERDU'}")
    print(f"🛡️ Mode failsafe: {'🔴 ACTIF' if status['failsafe'] else '🟢 INACTIF'}")
    print(f"🏁 Géofence: {'🟢 OK' if status['geofence_ok'] else '🔴 VIOLATION'}")
    
    # Historique urgences récentes
    recent_emergencies = get_recent_emergencies()
    if recent_emergencies:
        print("\n📋 Urgences récentes:")
        for emergency in recent_emergencies[-3:]:
            timestamp = datetime.fromisoformat(emergency['timestamp'])
            print(f"   {timestamp.strftime('%H:%M:%S')} - {emergency['type']}")
    
    return 0


def safety_override(node, args):
    """Override des systèmes de sécurité"""
    print("🔓 === OVERRIDE SÉCURITÉ ===")
    print("⚠️ ATTENTION: Désactivation temporaire des sécurités")
    
    # Vérification code
    if args.code:
        if not verify_override_code(args.code):
            print("❌ Code d'override invalide")
            return 1
    else:
        code = input("Code d'override: ")
        if not verify_override_code(code):
            print("❌ Code d'override invalide")
            return 1
    
    print(f"🔓 Override activé pour {args.duration}s")
    print("⚠️ Sécurités désactivées temporairement")
    
    # Simulation de l'override
    print(f"⏳ Override actif...")
    time.sleep(min(args.duration, 3))
    print("🔒 Override expiré - Sécurités réactivées")
    
    # Log critique
    log_emergency_event({
        'type': 'SAFETY_OVERRIDE',
        'duration': args.duration,
        'timestamp': datetime.now().isoformat(),
        'severity': 'CRITICAL'
    })
    
    return 0


def get_launch_point():
    """Récupère le point de décollage"""
    # Simulation
    return {
        'lat': 45.7640,
        'lon': 4.8357,
        'alt': 200.0
    }


def get_current_position():
    """Récupère la position actuelle"""
    # Simulation
    return {
        'lat': 45.7650,
        'lon': 4.8367,
        'alt': 50.0
    }


def get_safe_zone_center():
    """Récupère le centre de la zone sûre"""
    # Simulation
    return {
        'lat': 45.7645,
        'lon': 4.8362
    }


def get_geofence_status():
    """Récupère le statut géofence"""
    # Simulation
    return {
        'inside': True,
        'distance_to_fence': 120.5,
        'active_fence': 'MAIN_AREA'
    }


def get_emergency_status():
    """Récupère le statut des systèmes d'urgence"""
    # Simulation
    return {
        'battery': 75.0,
        'telemetry': True,
        'rc_link': True,
        'failsafe': False,
        'geofence_ok': True
    }


def get_recent_emergencies():
    """Récupère les urgences récentes"""
    # Simulation
    return [
        {
            'type': 'LOW_BATTERY_WARNING',
            'timestamp': '2024-01-15T14:30:25'
        }
    ]


def verify_override_code(code):
    """Vérifie le code d'override"""
    # Code simple pour demo - À sécuriser en production
    return code == "EMERGENCY_OVERRIDE_2024"


def log_emergency_event(event):
    """Log un événement d'urgence"""
    log_file = "/tmp/drone_emergency.log"
    
    try:
        with open(log_file, 'a') as f:
            f.write(json.dumps(event) + '\n')
        print(f"📝 Événement loggé: {log_file}")
    except Exception as e:
        print(f"⚠️ Erreur logging: {e}")


if __name__ == '__main__':
    sys.exit(main())
