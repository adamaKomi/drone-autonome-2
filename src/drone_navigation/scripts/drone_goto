#!/usr/bin/env python3
"""
Script CLI: drone_goto - Navigation directe vers une position
Usage: drone_goto <x> <y> [z] [yaw]
"""

import rclpy
from rclpy.node import Node
import sys
import argparse
import math
from geometry_msgs.msg import PoseStamped


def main():
    parser = argparse.ArgumentParser(description='Navigation directe vers une position')
    parser.add_argument('x', type=float, help='Position X (m)')
    parser.add_argument('y', type=float, help='Position Y (m)')
    parser.add_argument('z', type=float, default=5.0, nargs='?', help='Position Z (m) - défaut: 5.0')
    parser.add_argument('--yaw', type=float, default=0.0, help='Orientation yaw (rad) - défaut: 0.0')
    parser.add_argument('--frame', type=str, default='map', help='Frame de référence - défaut: map')
    parser.add_argument('--timeout', type=float, default=10.0, help='Timeout (s) - défaut: 10.0')
    
    args = parser.parse_args()
    
    print(f"🎯 Navigation vers ({args.x}, {args.y}, {args.z}) yaw={args.yaw}")
    
    rclpy.init()
    
    try:
        node = Node('drone_goto_cli')
        
        # Publisher pour la position cible
        goal_publisher = node.create_publisher(
            PoseStamped,
            '/drone_nav/goal_position',
            10
        )
        
        # Construction du message
        goal_msg = PoseStamped()
        goal_msg.header.stamp = node.get_clock().now().to_msg()
        goal_msg.header.frame_id = args.frame
        goal_msg.pose.position.x = args.x
        goal_msg.pose.position.y = args.y
        goal_msg.pose.position.z = args.z
        
        # Conversion yaw vers quaternion
        goal_msg.pose.orientation.z = math.sin(args.yaw / 2)
        goal_msg.pose.orientation.w = math.cos(args.yaw / 2)
        
        # Publication
        goal_publisher.publish(goal_msg)
        
        print(f"✅ Commande envoyée vers ({args.x}, {args.y}, {args.z})")
        print("📡 Le drone devrait commencer la navigation...")
        
    except Exception as e:
        print(f"❌ Erreur: {e}")
        return 1
    finally:
        rclpy.shutdown()
    
    return 0


if __name__ == '__main__':
    sys.exit(main())
