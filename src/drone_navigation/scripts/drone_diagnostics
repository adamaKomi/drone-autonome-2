#!/usr/bin/env python3
"""
Script CLI: drone_diagnostics - Diagnostics système drone
Usage: drone_diagnostics [options]
"""

import rclpy
from rclpy.node import Node
import sys
import argparse
import json
import time
from datetime import datetime, timedelta


def main():
    parser = argparse.ArgumentParser(description='Diagnostics système drone')
    parser.add_argument('--json', action='store_true', help='Sortie JSON')
    parser.add_argument('--detailed', action='store_true', help='Diagnostics détaillés')
    parser.add_argument('--component', help='Diagnostiquer un composant spécifique')
    parser.add_argument('--watch', type=int, help='Mode surveillance (secondes)')
    parser.add_argument('--export', help='Exporter vers fichier')
    parser.add_argument('--threshold', choices=['info', 'warn', 'error'], default='info',
                       help='Seuil d\'affichage des messages')
    
    args = parser.parse_args()
    
    rclpy.init()
    
    try:
        node = Node('drone_diagnostics_cli')
        
        if args.watch:
            return watch_mode(node, args)
        else:
            return single_diagnostics(node, args)
            
    except KeyboardInterrupt:
        print("\n🛑 Diagnostics interrompus")
        return 0
    except Exception as e:
        print(f"❌ Erreur: {e}")
        return 1
    finally:
        rclpy.shutdown()


def single_diagnostics(node, args):
    """Exécute un diagnostic unique"""
    print("🔍 === DIAGNOSTICS DRONE ===")
    
    # Collecte des données
    diagnostics_data = collect_diagnostics(node, args.component, args.detailed)
    
    # Affichage
    if args.json:
        print(json.dumps(diagnostics_data, indent=2))
    else:
        display_diagnostics(diagnostics_data, args.threshold, args.detailed)
    
    # Export
    if args.export:
        export_diagnostics(diagnostics_data, args.export)
    
    return 0


def watch_mode(node, args):
    """Mode surveillance continue"""
    print(f"👀 Mode surveillance (actualisation: {args.watch}s)")
    print("Appuyez sur Ctrl+C pour arrêter")
    
    try:
        while True:
            # Clear screen
            print("\033[2J\033[H")
            
            print(f"🔍 === DIAGNOSTICS DRONE === {datetime.now().strftime('%H:%M:%S')}")
            
            diagnostics_data = collect_diagnostics(node, args.component, args.detailed)
            display_diagnostics(diagnostics_data, args.threshold, args.detailed)
            
            time.sleep(args.watch)
            
    except KeyboardInterrupt:
        return 0


def collect_diagnostics(node, component_filter=None, detailed=False):
    """Collecte les données de diagnostic"""
    # Simulation de collecte de données - À remplacer par vraies sources
    diagnostics = {
        'timestamp': datetime.now().isoformat(),
        'system': collect_system_diagnostics(detailed),
        'mavros': collect_mavros_diagnostics(detailed),
        'navigation': collect_navigation_diagnostics(detailed),
        'sensors': collect_sensors_diagnostics(detailed),
        'battery': collect_battery_diagnostics(detailed),
        'communication': collect_communication_diagnostics(detailed)
    }
    
    # Filtrage par composant
    if component_filter:
        if component_filter in diagnostics:
            diagnostics = {
                'timestamp': diagnostics['timestamp'],
                component_filter: diagnostics[component_filter]
            }
        else:
            print(f"⚠️ Composant '{component_filter}' non trouvé")
    
    return diagnostics


def collect_system_diagnostics(detailed=False):
    """Diagnostics système général"""
    import psutil
    
    # CPU et mémoire
    cpu_percent = psutil.cpu_percent(interval=1)
    memory = psutil.virtual_memory()
    
    system_diag = {
        'status': 'OK' if cpu_percent < 80 and memory.percent < 85 else 'WARNING',
        'cpu_usage': cpu_percent,
        'memory_usage': memory.percent,
        'disk_usage': psutil.disk_usage('/').percent,
        'uptime': time.time() - psutil.boot_time(),
        'issues': []
    }
    
    # Détection problèmes
    if cpu_percent > 90:
        system_diag['issues'].append({
            'level': 'ERROR',
            'message': f'CPU surchargé: {cpu_percent:.1f}%'
        })
    elif cpu_percent > 80:
        system_diag['issues'].append({
            'level': 'WARN',
            'message': f'CPU élevé: {cpu_percent:.1f}%'
        })
    
    if memory.percent > 90:
        system_diag['issues'].append({
            'level': 'ERROR',
            'message': f'Mémoire critique: {memory.percent:.1f}%'
        })
    
    if detailed:
        system_diag['processes'] = get_ros_processes()
        system_diag['temperature'] = get_system_temperature()
    
    return system_diag


def collect_mavros_diagnostics(detailed=False):
    """Diagnostics MAVROS"""
    # Simulation - À remplacer par vraie interface MAVROS
    mavros_diag = {
        'status': 'CONNECTED',
        'connection_quality': 95,
        'last_heartbeat': 0.1,
        'flight_mode': 'GUIDED',
        'armed': False,
        'gps_status': 'FIX_3D',
        'gps_satellites': 12,
        'issues': []
    }
    
    # Vérifications
    if mavros_diag['last_heartbeat'] > 1.0:
        mavros_diag['issues'].append({
            'level': 'ERROR',
            'message': f'Heartbeat retardé: {mavros_diag["last_heartbeat"]:.2f}s'
        })
    
    if mavros_diag['gps_satellites'] < 6:
        mavros_diag['issues'].append({
            'level': 'WARN',
            'message': f'Peu de satellites GPS: {mavros_diag["gps_satellites"]}'
        })
    
    if detailed:
        mavros_diag['parameters'] = get_mavros_parameters()
        mavros_diag['topics_hz'] = get_topic_frequencies()
    
    return mavros_diag


def collect_navigation_diagnostics(detailed=False):
    """Diagnostics navigation"""
    nav_diag = {
        'status': 'READY',
        'active_nodes': get_active_navigation_nodes(),
        'mission_status': 'IDLE',
        'trajectory_valid': True,
        'path_planner': 'A_STAR',
        'issues': []
    }
    
    # Vérifications
    required_nodes = [
        'core_navigation_node',
        'parameter_manager_node',
        'mavros_interface_node'
    ]
    
    missing_nodes = [node for node in required_nodes 
                    if node not in nav_diag['active_nodes']]
    
    for missing in missing_nodes:
        nav_diag['issues'].append({
            'level': 'ERROR',
            'message': f'Nœud manquant: {missing}'
        })
    
    if detailed:
        nav_diag['parameters'] = get_navigation_parameters()
        nav_diag['performance'] = get_navigation_performance()
    
    return nav_diag


def collect_sensors_diagnostics(detailed=False):
    """Diagnostics capteurs"""
    sensors_diag = {
        'status': 'OK',
        'imu': {'status': 'OK', 'calibrated': True, 'noise_level': 0.02},
        'gps': {'status': 'OK', 'hdop': 1.2, 'vdop': 1.8},
        'barometer': {'status': 'OK', 'pressure': 1013.25},
        'compass': {'status': 'OK', 'declination': 2.3},
        'issues': []
    }
    
    # Vérifications IMU
    if sensors_diag['imu']['noise_level'] > 0.1:
        sensors_diag['issues'].append({
            'level': 'WARN',
            'message': f'Bruit IMU élevé: {sensors_diag["imu"]["noise_level"]:.3f}'
        })
    
    # Vérifications GPS
    if sensors_diag['gps']['hdop'] > 2.0:
        sensors_diag['issues'].append({
            'level': 'WARN',
            'message': f'Précision GPS faible: HDOP {sensors_diag["gps"]["hdop"]}'
        })
    
    if detailed:
        sensors_diag['calibration_status'] = get_sensor_calibration()
        sensors_diag['data_rates'] = get_sensor_rates()
    
    return sensors_diag


def collect_battery_diagnostics(detailed=False):
    """Diagnostics batterie"""
    battery_diag = {
        'status': 'OK',
        'voltage': 12.6,
        'current': -5.2,
        'remaining': 85,
        'temperature': 25.3,
        'cycles': 45,
        'estimated_flight_time': 18.5,
        'issues': []
    }
    
    # Vérifications batterie
    if battery_diag['voltage'] < 11.1:
        battery_diag['issues'].append({
            'level': 'ERROR',
            'message': f'Tension critique: {battery_diag["voltage"]:.1f}V'
        })
    elif battery_diag['voltage'] < 11.8:
        battery_diag['issues'].append({
            'level': 'WARN',
            'message': f'Tension faible: {battery_diag["voltage"]:.1f}V'
        })
    
    if battery_diag['temperature'] > 40:
        battery_diag['issues'].append({
            'level': 'WARN',
            'message': f'Température élevée: {battery_diag["temperature"]:.1f}°C'
        })
    
    if detailed:
        battery_diag['cell_voltages'] = [3.9, 4.1, 4.0, 3.8]
        battery_diag['health'] = calculate_battery_health(battery_diag)
    
    return battery_diag


def collect_communication_diagnostics(detailed=False):
    """Diagnostics communication"""
    comm_diag = {
        'status': 'OK',
        'telemetry_link': {'status': 'CONNECTED', 'rssi': -45, 'packet_loss': 0.1},
        'rc_link': {'status': 'CONNECTED', 'rssi': -38, 'failsafe': False},
        'wifi_link': {'status': 'CONNECTED', 'signal': -42, 'bitrate': 150},
        'issues': []
    }
    
    # Vérifications liens
    if comm_diag['telemetry_link']['packet_loss'] > 5.0:
        comm_diag['issues'].append({
            'level': 'ERROR',
            'message': f'Perte paquets élevée: {comm_diag["telemetry_link"]["packet_loss"]:.1f}%'
        })
    
    if comm_diag['rc_link']['failsafe']:
        comm_diag['issues'].append({
            'level': 'ERROR',
            'message': 'Mode failsafe RC actif'
        })
    
    if detailed:
        comm_diag['bandwidth_usage'] = get_bandwidth_usage()
        comm_diag['latency'] = measure_communication_latency()
    
    return comm_diag


def display_diagnostics(data, threshold, detailed):
    """Affiche les diagnostics formatés"""
    
    # Compteurs globaux
    total_issues = 0
    error_count = 0
    warning_count = 0
    
    # Parcours des composants
    for component, diag in data.items():
        if component == 'timestamp':
            continue
            
        if not isinstance(diag, dict):
            continue
        
        print(f"\n🔧 {component.upper()}")
        print(f"   Status: {get_status_icon(diag.get('status', 'UNKNOWN'))} {diag.get('status', 'UNKNOWN')}")
        
        # Affichage des métriques principales
        display_component_metrics(component, diag, detailed)
        
        # Issues
        issues = diag.get('issues', [])
        if issues:
            for issue in issues:
                level = issue['level']
                if should_display_issue(level, threshold):
                    icon = get_issue_icon(level)
                    print(f"   {icon} {issue['message']}")
                    total_issues += 1
                    if level == 'ERROR':
                        error_count += 1
                    elif level == 'WARN':
                        warning_count += 1
    
    # Résumé global
    print(f"\n📊 === RÉSUMÉ ===")
    if total_issues == 0:
        print("✅ Tous les systèmes fonctionnent normalement")
    else:
        print(f"⚠️ {total_issues} problème(s) détecté(s):")
        if error_count > 0:
            print(f"   🔴 {error_count} erreur(s)")
        if warning_count > 0:
            print(f"   🟡 {warning_count} avertissement(s)")


def display_component_metrics(component, diag, detailed):
    """Affiche les métriques spécifiques à chaque composant"""
    
    if component == 'system':
        print(f"   CPU: {diag.get('cpu_usage', 0):.1f}% | RAM: {diag.get('memory_usage', 0):.1f}% | Disk: {diag.get('disk_usage', 0):.1f}%")
        if detailed and 'uptime' in diag:
            uptime_str = str(timedelta(seconds=int(diag['uptime'])))
            print(f"   Uptime: {uptime_str}")
    
    elif component == 'mavros':
        print(f"   Mode: {diag.get('flight_mode', 'N/A')} | GPS: {diag.get('gps_satellites', 0)} sats")
        print(f"   Heartbeat: {diag.get('last_heartbeat', 0):.3f}s | Quality: {diag.get('connection_quality', 0)}%")
    
    elif component == 'navigation':
        print(f"   Nœuds actifs: {len(diag.get('active_nodes', []))} | Mission: {diag.get('mission_status', 'N/A')}")
        print(f"   Planificateur: {diag.get('path_planner', 'N/A')}")
    
    elif component == 'battery':
        print(f"   {diag.get('voltage', 0):.1f}V | {diag.get('current', 0):.1f}A | {diag.get('remaining', 0)}%")
        print(f"   Temp: {diag.get('temperature', 0):.1f}°C | Vol restant: {diag.get('estimated_flight_time', 0):.1f}min")
    
    elif component == 'sensors':
        imu = diag.get('imu', {})
        gps = diag.get('gps', {})
        print(f"   IMU: {imu.get('status', 'N/A')} | GPS: HDOP {gps.get('hdop', 0):.1f}")
    
    elif component == 'communication':
        telem = diag.get('telemetry_link', {})
        rc = diag.get('rc_link', {})
        print(f"   Télémétrie: {telem.get('rssi', 0)}dBm | RC: {rc.get('rssi', 0)}dBm")


def get_status_icon(status):
    """Icône pour le statut"""
    icons = {
        'OK': '✅',
        'READY': '🟢',
        'CONNECTED': '🔗',
        'WARNING': '⚠️',
        'ERROR': '❌',
        'DISCONNECTED': '🔴',
        'UNKNOWN': '❓'
    }
    return icons.get(status, '❓')


def get_issue_icon(level):
    """Icône pour le niveau d'issue"""
    icons = {
        'ERROR': '🔴',
        'WARN': '🟡',
        'INFO': '🔵'
    }
    return icons.get(level, '❓')


def should_display_issue(level, threshold):
    """Détermine si l'issue doit être affichée selon le seuil"""
    levels = {'info': 0, 'warn': 1, 'error': 2}
    issue_level = levels.get(level.lower(), 0)
    threshold_level = levels.get(threshold, 0)
    return issue_level >= threshold_level


def export_diagnostics(data, filename):
    """Exporte les diagnostics vers un fichier"""
    try:
        with open(filename, 'w') as f:
            json.dump(data, f, indent=2)
        print(f"💾 Diagnostics exportés vers: {filename}")
    except Exception as e:
        print(f"❌ Erreur export: {e}")


