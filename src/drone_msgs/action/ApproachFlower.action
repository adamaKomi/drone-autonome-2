# Goal: Approach a specific flower for pollination
string flower_id
geometry_msgs/Point flower_position
float64 approach_distance       # Target distance from flower (meters)
float64 position_tolerance      # Acceptable position error
---
# Result: Approach completion status
bool success
string result_message
float64 final_distance
float64 approach_duration
geometry_msgs/Point final_position
---
# Feedback: Real-time approach progress
float64 current_distance
geometry_msgs/Point current_position
string approach_phase           # NAVIGATING, STABILIZING, POSITIONED
float64 position_error
