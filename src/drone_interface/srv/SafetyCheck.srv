# Service for safety checks
# Allows other nodes to query safety status and arm conditions

# Request
bool check_arm_conditions     # Check if drone can be armed
bool check_flight_safety      # Check current flight safety
geometry_msgs/Point check_position     # Check if position is safe
float32 check_altitude        # Check if altitude is safe

---

# Response
bool safe_to_arm             # Safe to arm the drone
bool flight_safe             # Current flight is safe
bool position_safe           # Requested position is safe
bool altitude_safe           # Requested altitude is safe

string arm_block_reason      # Reason why arming is blocked (if any)
string[] safety_warnings     # List of current safety warnings
string[] safety_errors       # List of current safety errors

# Safety limits
float32 max_safe_altitude    # Maximum safe altitude
float32 geofence_radius      # Current geofence radius
float32 min_battery_voltage  # Minimum required battery voltage
int32 min_gps_satellites     # Minimum required GPS satellites
